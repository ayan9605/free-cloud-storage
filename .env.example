# Server Configuration
PORT=3000
NODE_ENV=production

# Telegram Bot Configuration
BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHANNEL_ID=@your_private_channel_username

# MongoDB Atlas Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/telegram-storage?retryWrites=true&w=majority

# CORS Configuration (Add your frontend URLs)
FRONTEND_URL=http://localhost:5500,https://your-frontend-domain.com

# File Upload Configuration
MAX_FILE_SIZE=52428800
